cli_src = files(
    '../jxlatte-cli/src/main/java/com/traneptora/jxlatte/JXLatte.java',
    '../jxlatte-cli/src/main/java/com/traneptora/jxlatte/io/PFMWriter.java',
    '../jxlatte-cli/src/main/java/com/traneptora/jxlatte/io/PNGWriter.java',
)

cli_res = structured_sources(
    files(
        '../jxlatte-cli/src/main/resources/bt2020-d65-pq.icc.zz',
        '../jxlatte-cli/src/main/resources/bt709-d65-srgb.icc.zz',
    ),
)

jxlatte_lib_jar = jar('jxlatte-lib',
    sources: lib_src,
)

# Thin CLI jar (compile against lib). Not for end users — see uber-jar below.
jxlatte_cli_thin_jar = jar('jxlatte-cli-thin',
    sources: cli_src,
    java_resources: cli_res,
    link_with: jxlatte_lib_jar,
)

# Uber-jar (like Maven shade): self-contained java -jar, no Class-Path.
python3 = find_program('python3')
jxlatte_cli_jar = custom_target(
    'jxlatte-cli',
    output: 'jxlatte-cli.jar',
    input: [jxlatte_lib_jar, jxlatte_cli_thin_jar],
    command: [
        python3,
        files('merge-uber-jar.py'),
        '@OUTPUT@',
        'com.traneptora.jxlatte.JXLatte',
        '@INPUT@',
    ],
    build_by_default: true,
)
